    "# SJEKK\n",
    "import numpy as np\n",
    "\n",
    "n = np.linspace(1, 10, 10)\n",
    "E, L, rho = 1, 20, 1\n",
    "\n",
    "omega_n = ((n * np.pi - (np.pi/2)) / (L)) * np.sqrt(E/rho)\n",
    "print(omega_n)"
   ]
